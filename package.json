{
  "name": "consistorium",
  "version": "0.3.0",
  "description": "Local-first strategic context and agent continuity layer via MCP (stdio + Streamable HTTP)",
  "type": "module",
  "bin": {
    "consistorium": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugin.json",
    "mcp.json",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/mcp/server.js",
    "start:http": "node dist/cli/index.js serve --http",
    "cli": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-plugins",
    "development-intelligence",
    "git",
    "worktree",
    "ai-agents",
    "chatgpt",
    "repo-context",
    "agent-handoff"
  ],
  "author": {
    "name": "Renaissance AI",
    "url": "https://corpuslaw.us"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Renaissance-AI-Solutions/consistorium"
  },
  "homepage": "https://github.com/Renaissance-AI-Solutions/consistorium",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
